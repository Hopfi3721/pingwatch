# Скопируйте в .env (он в .gitignore) или задайте переменные в оболочке.

# HTTP-сервер и база
ADDR=:8080
DB_PATH=pingwatch.db

# Планировщик
WORKERS=8
FAILURE_THRESHOLD=3
RESULTS_RETENTION=5000

# Telegram (необязательно). Без токена алерты пишутся только в лог.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE=https://api.telegram.org
